{
  "enabledPlugins": {
    "ikeh-git@ikeh": true
  },
  "permissions": {
    "ask": [
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git -* push *main*)",
      "Bash(git -* push *master*)"
    ]
  },
  "pushGuard": {
    "allowAgenticPush": true,
    "remote": "origin",
    "requireWorktree": false
  }
}
