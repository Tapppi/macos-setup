#!/bin/bash

# Template for ~/.config/bash/.credentials, which .bash_profile sources first.
# Keep the copy untracked with mode 0600, and quote each value.

# Postman API key
export POSTMAN_APIKEY=

# context7 API key, read by the context7 MCP server in Claude Code and Codex.
# Re-running `ctx7 setup` writes the plain key back into ~/.claude.json.
export CONTEXT7_API_KEY=
